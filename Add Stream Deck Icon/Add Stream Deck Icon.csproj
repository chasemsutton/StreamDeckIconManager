<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <RootNamespace>Add_Stream_Deck_Icon</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>StreamDeckIconManagerLogo.ico</ApplicationIcon>
    <StartupObject>Add_Stream_Deck_Icon.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same file as ApplicationIcon, embedded so windows can use the full-resolution icon. -->
    <EmbeddedResource Include="StreamDeckIconManagerLogo.ico" LogicalName="AppIcon.ico" />
    <Compile Include="..\shared\ReleaseNaming.cs" Link="ReleaseNaming.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="Svg.Skia" Version="1.0.0.18" />
  </ItemGroup>

</Project>
