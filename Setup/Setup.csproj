<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>StreamDeckIconManager.Setup</RootNamespace>
    <AssemblyName>StreamDeckIconManagerSetup</AssemblyName>
    <ApplicationIcon>..\Add Stream Deck Icon\StreamDeckIconManagerLogo.ico</ApplicationIcon>
    <StartupObject>StreamDeckIconManager.Setup.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\shared\ReleaseNaming.cs" Link="ReleaseNaming.cs" />
    <!-- Share the app's look: colours, fonts, buttons and the dark title bar. -->
    <Compile Include="..\Add Stream Deck Icon\UI\Theme.cs" Link="UI\Theme.cs" />
    <Compile Include="..\Add Stream Deck Icon\UI\ThemedButton.cs" Link="UI\ThemedButton.cs" />
    <Compile Include="..\Add Stream Deck Icon\UI\Native.cs" Link="UI\Native.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Add Stream Deck Icon\StreamDeckIconManagerLogo.ico" Link="StreamDeckIconManagerLogo.ico" LogicalName="AppIcon.ico" />
  </ItemGroup>

</Project>
